---
interface Props {
    class?: string;
    file?: string;
}

import IconFileRss from "@tabler/icons/outline/file-rss.svg";
import IconBrightness from "@tabler/icons/outline/brightness.svg";

const { class: className, file } = Astro.props;

const date = new Date();

const commit: string | undefined = import.meta.env.GIT_COMMIT;

const baseUrlShort = "viperML/neohome";
const baseUrl = `https://github.com/${baseUrlShort}`;

const ref = (() => {
    if (commit !== undefined) {
        return commit;
    } else {
        return "astro";
    }
})();

const url =
    baseUrl +
    (() => {
        if (file === undefined) {
            return `/tree/${ref}`;
        } else {
            return `/blob/${ref}/${file}`;
        }
    })();

const urlShort =
    baseUrlShort +
    (() => {
        if (file !== undefined) {
            return `:${file}`;
        } else {
            return "";
        }
    })() +
    (() => {
        if (commit !== undefined) {
            return ` @ ${commit.substring(0, 7)}`;
        } else {
            return "";
        }
    })();

const iconSize = 30;
---

<footer class:list={[className]}>
    <p id="footer-copy">
        Posts © {date.getFullYear()} Fernando Ayats under <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            >CC-BY-NC-SA 4.0</a
        >
    </p>

    <p id="footer-provenance">
        Built with <a href="https://astro.build">Astro</a> from <a
            class="footer-break"
            href={url}>{urlShort}</a
        >
    </p>

    <div class="footer-buttons">
        <a href="/feed.xml">
            <IconFileRss height={iconSize} width={iconSize} />
        </a>

        <button id="themeToggle">
            <IconBrightness height={iconSize} width={iconSize} />
        </button>
    </div>

    <div class="inline footer-users">
        <span id="activeUsers">0</span> Active Users
    </div>
</footer>

<style lang="less">
    .footer-users {
        @media (max-width: 768px) {
            grid-row: 3;
        }
    }

    // #activeUsers {
    //     position: relative;
    // }

    #activeUsers::before {
        // position: absolute;
        content: "";
        display: inline-block;
        background-color: var(--color-red-400);
        width: 10px;
        height: 10px;
        // top: 50%;
        // left: 0%;
        border-radius: 100%;
        // transform: translate(0, -50%);
        margin-right: 4px;
    }

    #activeUsers.successful::before {
        background-color: var(--color-green-400);
    }

    footer {
        margin-top: 3rem;
        display: grid;
        width: 100%;
        grid-template-rows: auto;
        gap: 0.2rem 3rem;

        padding: 10px 20px;
        @media (min-width: 768px) {
            padding: 0;
        }

        color: var(--text-color-alt);
        font-size: 0.9rem;
    }

    .footer-break {
        word-break: break-all;
    }

    a {
        text-decoration: underline;
    }

    .footer-buttons {
        display: flex;
        gap: 2rem;
        align-items: center;
        justify-self: center;
        margin-top: 2rem;
        margin-bottom: 1.5rem;
    }

    svg,
    a {
        &:hover {
            color: var(--text-color-active);
        }

        transition: color 100ms ease-out;
    }

    @media (min-width: 768px) {
        footer {
            grid-template-columns: auto max-content;
        }

        #footer-copy {
            grid-column: 1;
            grid-row: 1;
        }

        #footer-provenance {
            grid-column: 1;
            grid-row: 2;
        }

        .footer-buttons {
            grid-row: 1 / span 2;
            grid-column: 2;
            margin: 0;
            gap: 1.5rem;
        }
    }
</style>

<script>
    const activeUsersElem = document.getElementById("activeUsers");
    if (activeUsersElem === null) {
        throw new Error("Active users element not found");
    }

    interface Response {
        activeUsers: number;
    }

    const url = new URL("https://shiva.ayats.org/user-count");
    const resp: Response = await (await fetch(url)).json();

    activeUsersElem.innerText = String(resp.activeUsers);
    activeUsersElem.classList = "successful";
</script>
